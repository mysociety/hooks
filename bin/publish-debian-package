#!/usr/bin/env python3

import argparse
import configparser
import pathlib
import requests
import os
import shutil
import subprocess
import tempfile
import zipfile

DEBIAN_REPO_PACKAGES_PATH = pathlib.Path("/") / "data" / "vhost" / "debian.mysociety.org" / "docs" / "dists"

config = configparser.ConfigParser()
config_filename = pathlib.Path(__file__).resolve().parent / "../conf/general.cfg"
config.read(config_filename)
token = pathlib.Path(config['packaging']['token_filename']).read_text()

parser = argparse.ArgumentParser(description="Download a debian package from GitHub and publish it.")
parser.add_argument("artifact_id", help="The ID of artifact in Github that contains the package.")
parser.add_argument("dist", help="The distribution of debian to publish under.")
parser.add_argument("arch",
    choices=["binary-amd64", "binary-arm64", "source"],
    help="The architecture to publish under."
)

if __name__ == '__main__':
    args = parser.parse_args()

    package_dir_path = DEBIAN_REPO_PACKAGES_PATH / args.dist / 'main' / args.arch

    if not package_dir_path.exists() or not package_dir_path.is_dir():
        raise Exception(f"A directory to put the package in {package_dir_path} does not exist.")


    artifact_download_path = None
    artifact_download_path = tempfile.mktemp()

    artifact_url = f"https://api.github.com/repos/mysociety/packaging/actions/artifacts/{args.artifact_id}/zip"
    headers = {
        "Accept": "application/vnd.github+json",
        "Authorization": f"Bearer {token}",
        "X-GitHub-Api-Version": "2022-11-28"
    }
    print(f'Attempting to download artifact to {artifact_download_path}...')
    with requests.get(artifact_url, headers=headers, stream=True) as response:
        if response.status_code == 200:
            with open(artifact_download_path, 'wb') as temp_file:
                for chunk in response.iter_content(chunk_size=8192):
                    temp_file.write(chunk)
        else:
            raise Exception(f"Failed to download artifact: {response.status_code} - {response.text}.")


    print('Artifact downloaded.')

    try:
        with tempfile.TemporaryDirectory() as temp_dir:
            print(f'Attempting to unzip artifact to {temp_dir}.')
            with zipfile.ZipFile(artifact_download_path, 'r') as zip_ref:
                zip_ref.extractall(temp_dir)

            print('Artifact unzipped.')

            deb_files = list(pathlib.Path(temp_dir).glob("*.deb"))
            if not deb_files:
                raise Exception('No .deb file found in unzipped artifact.')
            if len(deb_files) > 1:
                raise Exception('More than one .deb file found in unzipped artifact.')
            deb_file = deb_files[0]

            print(f'Found deb file {deb_file} in extracted zip.')
            print(f'Copying the deb file to {package_dir_path}...')
            shutil.copy(deb_file, package_dir_path / deb_file.name)
            print(f'{deb_file} was copied over.')
    finally:
        if os.path.exists(artifact_download_path):
            os.remove(artifact_download_path)

    print('Running publish script...')
    subprocess.run(['/data/mysociety/bin/debian-vhost-update'], check=True)
    print('Package published.')
